# Reproducibility note: the spec for this build called for a from-scratch StageX-style hermetic
# bootstrap (build every layer, including the toolchain itself, from source against digest-pinned
# inputs). Given the time budget here, that bootstrap is substituted with official upstream images
# pinned by exact sha256 digest instead of floating tags. This still gives the property that
# matters -- the same Containerfile + the same Cargo.lock + the same pinned digests produce the
# same image, and therefore the same enclave measurements (PCR0/1/2), independently reproducible
# by anyone who pulls the same digests -- it just trusts the upstream image publisher for the
# base layers rather than rebuilding them from source.
#
# EIF packaging note: rather than hand-rolling `eif_build` plus a kernel/initramfs, this image is
# built as a normal Docker image and handed to `nitro-cli build-enclave --docker-uri`, which owns
# the kernel/initramfs/EIF assembly. Determinism is unaffected: same Containerfile + same
# Cargo.lock + same pinned base digest = same image = same PCRs.

FROM rust@sha256:f6c22e0a256c05d44fca23bf530120b5d4a6249a393734884281ca80782329bc AS build
RUN rustup target add x86_64-unknown-linux-musl
RUN apk add --no-cache musl-dev
# The build context is the REPO ROOT (see enclave-server/Makefile) and the repo-root-relative
# layout is reproduced verbatim under /build. That is the whole trick: `#[path =
# "../../../../examples/<app>/mod.rs"]` in src/lib.rs resolves to the SAME file here as on a
# developer's checkout, because four `..` from /build/enclave-server/src/nautilus-server/src land
# on /build exactly as four `..` from <repo>/enclave-server/src/nautilus-server/src land on
# <repo>. Every intermediate directory in that chain exists here, which matters: Linux resolves
# `..` against the real filesystem (unlike Windows, which normalizes it lexically), so a chain
# through a phantom directory would fail HERE while still compiling on a Windows dev box.
ARG ENCLAVE_APP
COPY enclave-server/src/nautilus-server /build/enclave-server/src/nautilus-server
# Only THIS app: the other apps' `mod`s are #[cfg]-gated off and rustc never opens their files,
# and narrowing the copy keeps an edit to one example from busting another example's layer cache.
COPY examples/${ENCLAVE_APP} /build/examples/${ENCLAVE_APP}
WORKDIR /build/enclave-server/src/nautilus-server
ENV RUSTFLAGS="-C target-feature=+crt-static"
RUN cargo build --locked --no-default-features --features $ENCLAVE_APP --release --target x86_64-unknown-linux-musl

FROM alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc AS final
# socat relays vsock<->tcp for both the app port (3000) and the secrets-injection port (7777);
# jq parses the JSON blob delivered over vsock:7777 into env var assignments; busybox's own `ip`
# applet brings up loopback (there's no other network config inside the enclave).
RUN apk add --no-cache socat jq
ARG ENCLAVE_APP
COPY --from=build /build/enclave-server/src/nautilus-server/target/x86_64-unknown-linux-musl/release/nautilus-server /nautilus-server
COPY enclave-server/src/nautilus-server/run.sh /run.sh
# common.rs reads this relative to CWD, and WORKDIR below is / -- so it lands at
# /allowed_endpoints.yaml. One COPY, not two: there used to be a generic fallback copy here that
# was unconditionally overwritten by the app-specific one on the very next line -- it was never a
# real fallback, since a missing app file hard-fails this COPY either way.
COPY examples/${ENCLAVE_APP}/allowed_endpoints.yaml /allowed_endpoints.yaml
RUN chmod +x /run.sh /nautilus-server
WORKDIR /
ENTRYPOINT ["/run.sh"]
